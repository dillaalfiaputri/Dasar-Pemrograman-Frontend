<!DOCTYPE html>
<html>
<head>
    <title>Laporan Penjualan</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>

        body{
            background:#f5f7fb;
        }

        .card-custom{
            border:none;
            border-radius:15px;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
        }

        .table thead{
            background:#0d6efd;
            color:white;
        }

        .badge-status{
            padding:7px 12px;
            border-radius:20px;
            font-size:13px;
        }

        .header-title{
            font-weight:bold;
        }

    </style>
</head>

<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="header-title">
                📊 Laporan Penjualan
            </h2>

            <p class="text-muted">
                Data seluruh transaksi penjualan obat
            </p>
        </div>

        <a href="/" class="btn btn-primary">
            ← Kembali
        </a>

    </div>

<div class="card card-custom mb-4">

    <div class="card-body">

        <form
          method="GET"
          action="/laporan-penjualan"
          class="row g-3 align-items-end"
        >

            <div class="col-md-4">

                <label class="form-label">
                    Dari Tanggal
                </label>

                <input
                  type="date"
                  name="tanggal_awal"
                  class="form-control"
                  value="<%= tanggal_awal %>"
                >

            </div>

            <div class="col-md-4">

                <label class="form-label">
                    Sampai Tanggal
                </label>

                <input
                  type="date"
                  name="tanggal_akhir"
                  class="form-control"
                  value="<%= tanggal_akhir %>"
                >

            </div>

            <div class="col-md-4">

                <button
                  type="submit"
                  class="btn btn-primary"
                >
                  Cari
                </button>

                <a
                  href="/laporan-penjualan"
                  class="btn btn-secondary"
                >
                  Reset
                </a>

            </div>

        </form>

    </div>

</div>

    <div class="card card-custom">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle text-center">

                    <thead>

                        <tr>
                            <th>No Order</th>
                            <th>Tanggal</th>
                            <th>Nama Pembeli</th>
                            <th>Telepon</th>
                            <th>Jumlah Item</th>
                            <th>Nama Barang</th>
                            <th>Total</th>
                            <th>Metode Bayar</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>

                    </thead>

                    <tbody>

                    <% if(laporan.length === 0){ %>

                        <tr>

                            <td colspan="10">

                                <div class="py-5">

                                    <h5 class="text-muted">
                                        Belum ada data penjualan
                                    </h5>

                                    <p class="text-secondary">
                                        Data transaksi akan muncul di sini
                                    </p>

                                </div>

                            </td>

                        </tr>

                    <% } %>

                    <% laporan.forEach(item => { %>

                        <tr>

                            <td>
                                <strong>
                                    <%= item.no_order %>
                                </strong>
                            </td>

                            <td>
                                <%= item.tanggal %>
                            </td>

                            <td>
                                <%= item.nama_pembeli %>
                            </td>

                            <td>
                                <%= item.telepon %>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    <%= item.jumlah_item %> item
                                </span>
                            </td>

                            <td>
                                <%= item.nama_barang %>
                            </td>

                            <td>
                                <strong>
                                    Rp <%= item.total %>
                                </strong>
                            </td>

                            <td>

                                <span class="badge bg-success">
                                    <%= item.metode_bayar %>
                                </span>

                            </td>

<td>

    <div class="d-flex flex-column gap-2 align-items-center">

        <span class="badge bg-warning text-dark">

            
            <%= item.status %>
        </span>

        <% if(item.status === "Menunggu Konfirmasi"){ %>

            <button
              class="btn btn-sm btn-primary"
              onclick="updateStatus('<%= item._id %>', 'Diproses')"
            >
              Proses
            </button>

        <% } %>

        <% if(item.status === "Diproses"){ %>

            <button
              class="btn btn-sm btn-warning"
              onclick="updateStatus('<%= item._id %>', 'Dikemas')"
            >
              Kemas
            </button>

        <% } %>

        <% if(item.status === "Dikemas"){ %>

            <button
              class="btn btn-sm btn-success"
              onclick="updateStatus('<%= item._id %>', 'Dikirim')"
            >
              Kirim
            </button>

        <% } %>

        <% if(item.status === "Dikirim"){ %>

            <span class="badge bg-info">
              Menunggu Customer
            </span>

        <% } %>

        <% if(item.status === "Selesai"){ %>

            <span class="badge bg-success">
              Pesanan Selesai
            </span>

        <% } %>

    </div>

</td>

<td>

    <a
      href="/detail-order/<%= item._id %>"
      class="btn btn-sm btn-info text-white mb-1"
    >
      Detail
    </a>

    <br>

    <a
      href="/delete-order/<%= item._id %>"
      class="btn btn-sm btn-danger mt-1"
      onclick="return confirm('Yakin ingin hapus pesanan ini?')"
    >
      Hapus
    </a>

</td>

</tr>

<% }) %>

                    </tbody>

                </table>

                <div class="d-flex justify-content-center mt-4">

    <nav>

        <ul class="pagination">

            <% if(currentPage > 1){ %>

                <li class="page-item">

                    <a
                      class="page-link"
                      href="/laporan-penjualan?page=<%= currentPage - 1 %>&tanggal_awal=<%= tanggal_awal %>&tanggal_akhir=<%= tanggal_akhir %>"
                    >
                      Previous
                    </a>

                </li>

            <% } %>

            <% for(let i = 1; i <= totalPages; i++){ %>

                <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                    <a
                      class="page-link"
                      href="/laporan-penjualan?page=<%= i %>&tanggal_awal=<%= tanggal_awal %>&tanggal_akhir=<%= tanggal_akhir %>"
                    >
                      <%= i %>
                    </a>

                </li>

            <% } %>

            <% if(currentPage < totalPages){ %>

                <li class="page-item">

                    <a
                      class="page-link"
                      href="/laporan-penjualan?page=<%= currentPage + 1 %>&tanggal_awal=<%= tanggal_awal %>&tanggal_akhir=<%= tanggal_akhir %>"
                    >
                      Next
                    </a>

                </li>

            <% } %>

        </ul>

    </nav>

</div>

            </div>

        </div>

    </div>

</div>

<script>

async function updateStatus(id, status) {

  try {

    const res = await fetch(
      `/update-order-status/${id}`,
      {
        method: "PUT",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          status
        })
      }
    );

    const data = await res.json();

    if(res.ok){

      alert("Status berhasil diupdate");

      location.reload();

    } else {

      alert(data.message);

    }

  } catch(err){

    console.log(err);

    alert("Terjadi error");

  }

}

</script>

</body>
</html>