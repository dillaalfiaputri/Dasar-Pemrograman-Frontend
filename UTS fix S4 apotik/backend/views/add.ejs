<!DOCTYPE html>
<html>
<head>
<title>Tambah Obat</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="container mt-5">

<h2>Tambah Obat</h2>

<form action="/add" method="POST" enctype="multipart/form-data">

<input type="text" name="kode" placeholder="Kode Obat" class="form-control mb-2" required>

<input type="text" name="nama" placeholder="Nama Obat" class="form-control mb-2" required>

<input type="text" name="kategori" placeholder="Kategori" class="form-control mb-2" required>

<input type="number" name="harga" placeholder="Harga Jual" class="form-control mb-2" required>

<input type="number" name="harga_pokok" placeholder="Harga Pokok" class="form-control mb-2">

<input type="number" name="jumlah" placeholder="Stok" class="form-control mb-2" required>

<input type="text" name="pt" placeholder="PT / Produsen" class="form-control mb-2">

<textarea name="deskripsi" placeholder="Deskripsi" class="form-control mb-2"></textarea>

<label class="form-label">Foto Obat</label>

<input 
    type="file"
    id="fileInput"
    accept="image/*"
    name="file"
    class="form-control mb-3">

<img 
    id="preview"
    src=""
    class="img-thumbnail mb-3"
    style="max-width:200px; display:none;">

<hr>

<h5>Atau Gunakan Kamera Laptop</h5>

<video 
    id="video" 
    width="400" 
    autoplay
    class="border rounded mb-2">
</video>

<br>

<button 
    type="button" 
    id="openCamera"
    class="btn btn-primary mb-2">
    Buka Kamera
</button>

<button 
    type="button" 
    id="captureBtn"
    class="btn btn-warning mb-2">
    Ambil Foto
</button>

<canvas id="canvas" style="display:none;"></canvas>

<input type="hidden" name="image_data" id="image_data">

<script>

const video = document.getElementById('video');
const canvas = document.getElementById('canvas');

const openCamera = document.getElementById('openCamera');

const captureBtn = document.getElementById('captureBtn');

const imageData = document.getElementById('image_data');

openCamera.addEventListener('click', async function(){

    try{

        const stream = await navigator.mediaDevices.getUserMedia({
            video:true
        });

        video.srcObject = stream;

    }catch(error){

        alert("Kamera tidak bisa dibuka");

        console.log(error);

    }

});

captureBtn.addEventListener('click', function(){

    canvas.width = video.videoWidth;

    canvas.height = video.videoHeight;

    const ctx = canvas.getContext('2d');

    ctx.drawImage(video, 0, 0);

    const dataURL = canvas.toDataURL('image/png');

    document.getElementById('preview').src = dataURL;

    document.getElementById('preview').style.display = 'block';

    imageData.value = dataURL;

});

</script>

<button class="btn btn-success">Simpan</button>
<a href="/" class="btn btn-secondary">Kembali</a>

</form>

</body>
</html>