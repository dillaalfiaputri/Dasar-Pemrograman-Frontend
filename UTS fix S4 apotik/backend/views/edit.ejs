<!DOCTYPE html>
<html>
<head>
<title>Edit Obat</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="container mt-5">

<h2>Edit Obat</h2>

<form action="/edit/<%= obat._id %>" method="POST" enctype="multipart/form-data">

<input type="text" value="<%= obat.kode %>" class="form-control mb-2" disabled>

<input type="text" name="nama" value="<%= obat.nama %>" class="form-control mb-2" required>

<input type="text" name="kategori" value="<%= obat.kategori %>" class="form-control mb-2" required>

<input type="number" name="harga" value="<%= obat.harga %>" class="form-control mb-2" required>

<input type="number" name="harga_pokok" value="<%= obat.harga_pokok || 0 %>" class="form-control mb-2">

<p class="mb-3">
Profit: Rp <span id="profit">
<%= Math.round((obat.harga || 0) - (obat.harga_pokok || 0)) %>
</span>
</p>

<script>
function hitungProfit() {
    const harga = parseInt(document.querySelector('[name="harga"]').value) || 0;
    const pokok = parseInt(document.querySelector('[name="harga_pokok"]').value) || 0;
    const profit = harga - pokok;

    document.getElementById('profit').innerText = profit;
}

document.querySelector('[name="harga"]').addEventListener('input', hitungProfit);
document.querySelector('[name="harga_pokok"]').addEventListener('input', hitungProfit);
</script>

<input type="number" name="jumlah" value="<%= obat.jumlah %>" class="form-control mb-2" required>

<input type="text" name="pt" value="<%= obat.pt %>" class="form-control mb-2">

<textarea name="deskripsi" class="form-control mb-2"><%= obat.deskripsi %></textarea>

<div class="mb-2">
<p>Foto saat ini:</p>
<% if(obat.foto){ %>
<img
  src="<%= obat.foto.startsWith('http') ? obat.foto : '/images/' + obat.foto %>"
  width="100"
>
<% } else { %>
<span class="text-muted">Tidak ada</span>
<% } %>
</div>

<input type="file" name="file" class="form-control mb-3">

<button class="btn btn-primary">Update</button>
<a href="/" class="btn btn-secondary">Kembali</a>

</form>

</body>
</html>