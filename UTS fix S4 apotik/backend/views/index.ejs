<!DOCTYPE html>
<html>
<head>
<title>APOTEK VIA</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body style="background:#f5f7fb;">

<nav
  style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:30px 30px;
    background:#0f172a;
    color:#fff;
  "
>

  <div
    style="
      font-size:28px;
      font-weight:bold;
    "
  >
    💊 APOTEK VIA
  </div>

  <div style="display:flex; gap:10px;">

    <a
      href="/add"
      class="btn btn-light"
    >
      + Tambah Obat
    </a>

    <a
      href="/laporan-penjualan"
      class="btn btn-warning"
    >
      📊 Laporan Penjualan
    </a>

    <a href="/laporan-keuangan" class="btn btn-success">
    💰 Laporan Keuangan
    </a>

  </div>

</nav>

<div class="container mt-5">

    </div>

    <form method="GET" action="/" class="d-flex gap-2" style="width: 300px;">
        <input
            type="text"
            name="search"
            value="<%= search %>"
            class="form-control"
            placeholder="Cari obat..."
        >

        <button class="btn btn-success">
            🔍
        </button>
    </form>

</div>

<div
  class="card shadow-sm border-0"
  style="border-radius:15px;"
>

<div class="card-body">

<table class="table table-hover text-center align-middle">
<thead class="table-dark">
<tr>
<th>Kode</th>
<th>Nama</th>
<th>Kategori</th>
<th>Deskripsi</th>
<th>Harga</th>
<th>Harga Pokok</th>
<th>Profit</th>
<th>Stok</th>
<th>Foto</th>
<th>Aksi</th>
</tr>
</thead>

<tbody>

<% if(obat.length === 0){ %>
<tr>
<td colspan="10">Data tidak ditemukan</td>
</tr>
<% } %>

<% obat.forEach(o => { %>
<tr>
<td><%= o.kode %></td>
<td><%= o.nama %></td>
<td><%= o.kategori %></td>

<td>
<% if(o.deskripsi){ %>
    <span id="short-<%= o._id %>">
        <%= o.deskripsi.substring(0, 40) %>...
        <a href="#" onclick="toggleDesc('<%= o._id %>')">Lihat</a>
    </span>

    <span id="full-<%= o._id %>" style="display:none;">
        <%= o.deskripsi %>
        <a href="#" onclick="toggleDesc('<%= o._id %>')">Sembunyikan</a>
    </span>
<% } else { %>
    -
<% } %>
</td>

<td>Rp <%= o.harga %></td>
<td>Rp <%= o.harga_pokok || 0 %></td>

<td>
Rp <%= (o.harga || 0) - (o.harga_pokok || 0) %>
</td>

<td><%= o.jumlah %></td>

<td>
<% if(o.foto){ %>
<img
  src="<%= o.foto.startsWith('http') ? o.foto : '/images/' + o.foto %>"
  width="80"
>
<% } %>
</td>

<td class="text-center">
    <div class="d-inline-flex gap-2">
        <a href="/edit/<%= o._id %>" class="btn btn-warning btn-sm">Edit</a>
        <a href="/delete/<%= o._id %>" 
           class="btn btn-danger btn-sm"
           onclick="return confirm('Yakin mau hapus?')">
           Hapus
        </a>
    </div>
</td>
</tr>
<% }) %>

</tbody>
</table>

</div>

</div>

<nav>
<ul class="pagination justify-content-center">

<% for(let i = 1; i <= totalPages; i++) { %>
<li class="page-item <%= i === currentPage ? 'active' : '' %>">
    <a class="page-link" href="/?page=<%= i %>&search=<%= search %>">
        <%= i %>
    </a>
</li>
<% } %>

</ul>
</nav>

<script>
function toggleDesc(id) {
    const shortText = document.getElementById('short-' + id);
    const fullText = document.getElementById('full-' + id);

    if (fullText.style.display === 'none') {
        shortText.style.display = 'none';
        fullText.style.display = 'inline';
    } else {
        shortText.style.display = 'inline';
        fullText.style.display = 'none';
    }
}
</script>
</body>
</html>