<!DOCTYPE html>
<html>
<head>

  <title>Detail Order</title>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
  >

</head>

<body class="bg-light">

<div class="container mt-5">

  <div class="card shadow border-0">

    <div class="card-body">

      <h2 class="mb-4">
        📦 Detail Pesanan
      </h2>

      <p>
        <strong>No Order:</strong>
        <%= order.no_order %>
      </p>

      <p>
        <strong>Tanggal:</strong>
        <%= order.tanggal %>
      </p>

      <p>
        <strong>Nama Pembeli:</strong>
        <%= order.nama_pembeli %>
      </p>

      <p>
        <strong>Telepon:</strong>
        <%= order.telepon %>
      </p>

      <p>
        <strong>Metode Bayar:</strong>
        <%= order.metode_bayar %>
      </p>

      <p>
        <strong>Status:</strong>
        <span class="badge bg-success">
          <%= order.status %>
        </span>
      </p>

      <hr>

      <h4>Daftar Barang</h4>

      <table class="table table-bordered">

        <thead class="table-primary">

          <tr>
            <th>Nama Barang</th>
            <th>Qty</th>
            <th>Harga</th>
            <th>Subtotal</th>
            <th>Profit</th>
          </tr>

        </thead>

        <tbody>

        <% order.items.forEach(item => { %>

          <tr>

            <td><%= item.nama_barang %></td>

            <td><%= item.qty %></td>

            <td>
              Rp <%= item.harga %>
            </td>

            <td>
              Rp <%= item.subtotal %>
            </td>

            <td>
              Rp <%= item.profit %>
            </td>

          </tr>

        <% }) %>

        </tbody>

      </table>

      <h3 class="mt-4">
        Total:
        Rp <%= order.total %>
      </h3>

      <a
        href="/laporan-penjualan"
        class="btn btn-primary mt-3"
      >
        ← Kembali
      </a>

    </div>

  </div>

</div>

</body>
</html>
